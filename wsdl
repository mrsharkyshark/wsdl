#!/bin/sh
# wsdl - back up Steam Workshop .gma files (from the local Steam cache, or via
# SteamCMD), archive them as .xz, and fetch a preview image as AVIF.


usage() {
  cat <<EOF
Usage: $(basename "$0") [options] [ID-or-URL ...]
       cat ids.txt | $(basename "$0") [options]

Each item can be a Steam Workshop ID or a URL containing ?id=, e.g.
  1234567890
  'https://steamcommunity.com/sharedfiles/filedetails/?id=1234567890'
Quote URLs in the shell, because & and ? are special there.

For each item:
  1. If the .gma is already in the local Steam cache, back it up.
     Otherwise, download the item with SteamCMD.
  2. Compress the .gma to ID/ID_YYYYMMDD.gma.xz (Steam update date) and check it with xz -t.
  3. Once the archive checks out, remove the uncompressed copy. The
     .gma.xz is then the only backup, and the empty backup/ folder is removed.
  4. Download the addon's preview image as ID/ID.jpg (JPEG). Pass -a to
     convert it to ID/ID.avif instead.
  5. Offer to delete the SteamCMD download (y/N, per item). The local
     Steam cache is never touched.

If the archive fails its check, the uncompressed copy is kept so no data
is lost.

SteamCMD login: items are first tried anonymously. If SteamCMD reports
that login is required, you are prompted for your Steam username, then
SteamCMD prompts for your password and any Steam Guard code. Passwords
are entered into SteamCMD directly and never pass through this script.
Logging in saves a token, so later runs usually don't ask again.

Invalid entries are skipped with a warning.

Options:
  -u USER      Steam account for SteamCMD (default: try anonymous,
               then prompt for a username if login is required)
  -c PATH      steamcmd binary                       (default: $STEAMCMD)
  -d DIR       SteamCMD download directory           (default: $STEAMCMD_DIR)
  -w DIR       Steam client Workshop cache for the app (default: ~/.local/share/Steam/steamapps/workshop/content/APPID)
  -j JOBS      parallel jobs for archive/image work  (default: $JOBS)
  -r RETRIES   attempts for download and xz steps    (default: $RETRIES)
  -q QUALITY   avifenc quality, 0-100                (default: $QUALITY, with -a)
  -g APPID     Steam app ID of the game (default: 4000, Garry's Mod)
  -o DIR       directory to save results into         (default: current directory)
  -f           put all archives and images directly in -o DIR, not in one folder per ID
  -k           keep SteamCMD downloads (default: delete after a verified archive)
  -a           save the preview as AVIF (ID.avif) instead of JPEG
  -s SPEED     avifenc speed, 0 (slow) - 10 (fast)   (default: $SPEED, with -a)
  -h, --help   show this help and exit

Output, for each ID, in OUTDIR/ID/ (or directly in OUTDIR with -f):
  ID_YYYYMMDD.gma.xz  backup of the .gma, compressed and verified
                      (date is the Steam update date, UTC)
  ID.jpg              preview image (JPEG, default)
  ID.avif             preview image (with -a)

Items already done are skipped: an item with an archive is not copied or
recompressed again, and an existing preview image is not downloaded again.

Requires: curl, grep (GNU, -P), xargs, file, xz.
With -a, also avifenc. SteamCMD is required only when an item is not in
the local cache.
Optional: magick or convert (ImageMagick). Used to convert a non-JPEG
preview to JPEG (default) or to read formats avifenc can't (with -a).

The preview comes from Steam's public item-details API, so items whose
workshop page asks for sign-in still get their real image. The page's
og:image tag is used only as a fallback.

Examples:
  $(basename "$0") 1234567890
  $(basename "$0") 'https://steamcommunity.com/sharedfiles/filedetails/?id=1234567890'
  $(basename "$0") -g 730 -u your_steam_user 1234567890
  $(basename "$0") -a 1234567890
  $(basename "$0") -u your_steam_user 1234567890 1234567890
  cat ids.txt | $(basename "$0") -j 8
EOF
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Turn a Workshop ID or a sharedfiles URL (?id=NNN) into the bare ID.
# Prints nothing if the input has no usable ID.
normalize_id() {
  case $1 in
    *id=*) printf '%s\n' "$1" | sed -n 's/.*[?&]id=\([0-9][0-9]*\).*/\1/p' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Run a command up to $RETRIES times, pausing between attempts.
retry() {
  n=1
  while :; do
    "$@" && return 0
    echo "Retry $n/$RETRIES failed..." >&2
    [ "$n" -ge "$RETRIES" ] && return 1
    n=$((n + 1))
    sleep 1
  done
}

# Print the first .gma in directory $1 (nothing if none).
first_gma() {
  [ -d "$1" ] || return 0
  find "$1" -maxdepth 1 -type f -name '*.gma' | head -n 1
}

# Print the first .gma.xz in directory $1 (nothing if none).
first_archive() {
  [ -d "$1" ] || return 0
  find "$1" -maxdepth 1 -type f -name '*.gma.xz' | head -n 1
}

# Where an item's files go. Normally OUTDIR/ID/. With -f, everything goes
# directly into OUTDIR, and temporary backups go to OUTDIR/.backup/ID/.
item_dir() {
  if [ "$FLAT" -eq 1 ]; then echo "$OUTDIR"; else echo "$OUTDIR/$1"; fi
}

backup_dir() {
  if [ "$FLAT" -eq 1 ]; then echo "$OUTDIR/.backup/$1"; else echo "$OUTDIR/$1/backup"; fi
}

# Print the archive path for item $1 if one exists: ID_YYYYMMDD.gma.xz,
# or an older ID.gma.xz name.
find_archive() {
  d=$(item_dir "$1")
  [ -d "$d" ] || return 0
  for f in "$d/$1".gma.xz "$d/$1"_*.gma.xz; do
    if [ -f "$f" ]; then
      echo "$f"
      return 0
    fi
  done
  return 0
}

# Read a line from the terminal into REPLY. Fails if there is no terminal.
read_tty() {
  printf '%s' "$1" 2>/dev/null >/dev/tty || return 1
  read -r REPLY </dev/tty || return 1
}

# Yes/no prompt on the terminal. Default is no, including when there is no terminal.
ask_yn() {
  read_tty "$1 [y/N] " || return 1
  case $REPLY in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

# Map a MIME type to a file extension.
image_ext() {
  case $1 in
    image/jpeg) echo jpg ;;
    image/png)  echo png ;;
    image/gif)  echo gif ;;
    image/webp) echo webp ;;
    image/bmp)  echo bmp ;;
    *) return 1 ;;
  esac
}

# Convert $1 to AVIF at $2. Falls back to ImageMagick if avifenc can't read the input.
to_avif() {
  src=$1
  dst=$2

  if avifenc -q "$QUALITY" --speed "$SPEED" "$src" "$dst" >/dev/null 2>&1; then
    return 0
  fi
  rm -f "$dst"

  if command -v magick >/dev/null 2>&1; then
    conv=magick
  elif command -v convert >/dev/null 2>&1; then
    conv=convert
  else
    return 1
  fi

  tmp="$dst.png"
  "$conv" "$src[0]" "$tmp" 2>/dev/null \
    && avifenc -q "$QUALITY" --speed "$SPEED" "$tmp" "$dst" >/dev/null 2>&1
  status=$?
  rm -f "$tmp"
  [ "$status" -eq 0 ] || rm -f "$dst"
  return "$status"
}

# Print the preview image URL for item $1. Uses Steam's public item-details
# API, which works without signing in. Falls back to the page's og:image tag.
image_url() {
  url=$(curl -fsS --max-time 30 -X POST \
          "https://api.steampowered.com/ISteamRemoteStorage/GetPublishedFileDetails/v1/" \
          -d itemcount=1 -d "publishedfileids[0]=$1" 2>/dev/null \
        | sed -n 's/.*"preview_url" *: *"\([^"]*\)".*/\1/p' \
        | sed 's#\\/#/#g' \
        | head -n 1)
  if [ -z "$url" ]; then
    url=$(curl -fsS --max-time 30 "https://steamcommunity.com/sharedfiles/filedetails/?id=$1" 2>/dev/null \
          | grep -oP '(?<=<meta property="og:image" content=")[^"]+' \
          | head -n 1 \
          | sed 's/&amp;/\&/g')
  fi
  printf '%s\n' "$url"
}

# Convert $1 to JPEG at $2 (first frame, transparency flattened onto white).
to_jpeg() {
  src=$1
  dst=$2
  if command -v magick >/dev/null 2>&1; then
    conv=magick
  elif command -v convert >/dev/null 2>&1; then
    conv=convert
  else
    return 1
  fi
  if "$conv" "$src[0]" -background white -flatten -quality 92 "$dst" 2>/dev/null && [ -s "$dst" ]; then
    return 0
  fi
  rm -f "$dst"
  return 1
}

# Download image URL $2 for item $1 into directory $3.
# Default: save as $1.jpg. With -a: save as $1.avif.
fetch_image() {
  id=$1
  url=$2
  outdir=$3
  tmp="$outdir/${id}_download"

  if ! retry curl -fsSL --max-time 60 -o "$tmp" "$url"; then
    echo "Download failed for $id"
    rm -f "$tmp"
    return 1
  fi

  # Detect the real format from the content, not from the URL.
  mime=$(file -b --mime-type "$tmp")
  if ! ext=$(image_ext "$mime"); then
    echo "Not a supported image for $id (got: $mime)"
    rm -f "$tmp"
    return 1
  fi

  if [ "$AVIF" -eq 1 ]; then
    src="$outdir/${id}_tmp.$ext"
    mv -f "$tmp" "$src"
    if ! to_avif "$src" "$outdir/$id.avif"; then
      echo "AVIF conversion failed for $id"
      rm -f "$src" "$outdir/$id.avif"
      return 1
    fi
    rm -f "$src"
    return 0
  fi

  if [ "$ext" = jpg ]; then
    mv -f "$tmp" "$outdir/$id.jpg"
    return 0
  fi

  src="$outdir/${id}_tmp.$ext"
  mv -f "$tmp" "$src"
  if to_jpeg "$src" "$outdir/$id.jpg"; then
    rm -f "$src"
    return 0
  fi
  echo "JPEG conversion unavailable for $id (install ImageMagick); saved original as $id.$ext"
  mv -f "$src" "$outdir/$id.$ext"
  return 0
}

# Compress $1 into $2 without modifying the source. Writes via a .part file
# so a failed run never leaves a truncated archive behind.
xz_to() {
  xz -9e -c -- "$1" > "$2.part" && mv -f -- "$2.part" "$2" && return 0
  rm -f "$2.part"
  return 1
}

# Print the Steam update date (UTC, YYYYMMDD) of item $1.
item_date() {
  ts=$(curl -fsS --max-time 30 -X POST \
         "https://api.steampowered.com/ISteamRemoteStorage/GetPublishedFileDetails/v1/" \
         -d itemcount=1 -d "publishedfileids[0]=$1" 2>/dev/null \
       | sed -n 's/.*"time_updated" *: *\([0-9][0-9]*\).*/\1/p' \
       | head -n 1)
  [ -n "$ts" ] || return 1
  date -u -d "@$ts" +%Y%m%d
}

# Compress backup .gma $2 for item $1 into directory $3, named ID_DATE.gma.xz.
# $4 is the Steam update date.
archive_gma() {
  id=$1
  gma=$2
  outdir=$3
  date=$4
  dst="$outdir/${id}_${date}.gma.xz"

  if [ -f "$dst" ]; then
    echo "Skipping GMA compression for $id (already exists)"
    return 0
  fi

  echo "Compressing GMA for $id..."
  if ! retry xz_to "$gma" "$dst"; then
    echo "GMA compression failed for $id"
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Per-item stages
# ---------------------------------------------------------------------------

# Stage 1 (serial): make sure a backup exists if the .gma is in the local cache.
# Returns 0 if backed up or already backed up, 2 if SteamCMD is needed, 1 on error.
prepare_id() {
  id=$1
  bdir=$(backup_dir "$id")

  if [ -n "$(first_gma "$bdir")" ] || [ -n "$(find_archive "$id")" ]; then
    echo "Already backed up for $id"
    return 0
  fi

  # Use an existing copy from the Steam client cache or the SteamCMD folder,
  # so nothing is downloaded again.
  src=$(first_gma "$STEAM_WORKSHOP/$id")
  [ -n "$src" ] || src=$(first_gma "$STEAMCMD_DIR/steamapps/workshop/content/$APPID/$id")
  if [ -z "$src" ]; then
    return 2
  fi

  mkdir -p "$bdir" || return 1
  echo "Found existing .gma for $id, backing it up"
  if cp -p -- "$src" "$bdir/"; then
    return 0
  fi
  echo "Backup copy failed for $id"
  return 1
}

# Stage 2: SteamCMD. Runs one batch for the IDs listed in file $2 with login $1.
run_batch() {
  login=$1
  listfile=$2
  set -- +force_install_dir "$STEAMCMD_DIR" +login "$login"
  for id in $(cat "$listfile"); do
    set -- "$@" +workshop_download_item "$APPID" "$id"
  done
  set -- "$@" +quit
  "$STEAMCMD" "$@" </dev/null 2>&1 | tee "$STEAMCMD_DIR/last-run.log"
}

# True if the last SteamCMD run reported that login is required.
# $1 is the login used for that run. For anonymous runs, a failed download
# also means login is needed, since Workshop downloads require an account.
needs_login() {
  grep -qiE 'Login Failure|Invalid Password|Steam Guard|Two-factor|Not Logged On|Access Denied|Need to be logged in|requires login' \
    "$STEAMCMD_DIR/last-run.log" && return 0
  [ "$1" = anonymous ] && grep -qE 'Download item [0-9]+ failed' "$STEAMCMD_DIR/last-run.log"
}

# Log in interactively so SteamCMD can prompt for the password and Steam Guard code.
steamcmd_login() {
  echo "Logging in as $1. SteamCMD will ask for your password and, if needed, a Steam Guard code."
  "$STEAMCMD" +force_install_dir "$STEAMCMD_DIR" +login "$1" +quit </dev/tty >/dev/tty 2>&1
}

# Download the IDs in $NEEDFILE with SteamCMD, prompting for login if required.
download_needed() {
  [ -s "$NEEDFILE" ] || return 0

  if ! command -v "$STEAMCMD" >/dev/null 2>&1; then
    echo "steamcmd not found (install it or set it with -c PATH)" >&2
    return 1
  fi
  mkdir -p "$STEAMCMD_DIR" || return 1

  first=${STEAM_USER:-anonymous}
  run_batch "$first" "$NEEDFILE"

  if needs_login "$first"; then
    echo "SteamCMD reports that login is required."
    if [ -z "$STEAM_USER" ]; then
      if ! read_tty "Steam username: "; then
        echo "Login is required but there is no terminal to ask on. Run again from a terminal, or use -u USER." >&2
        return 1
      fi
      STEAM_USER=$REPLY
    fi
    steamcmd_login "$STEAM_USER" || return 1
    run_batch "$STEAM_USER" "$NEEDFILE"
  fi

  # Steam sometimes refuses a download temporarily ("Failure"). Retry the
  # items that are still missing, up to RETRIES attempts in total.
  n=1
  while [ "$n" -lt "$RETRIES" ]; do
    missing="$WORK/missing"
    : > "$missing"
    while read -r id; do
      [ -n "$(first_gma "$STEAMCMD_DIR/steamapps/workshop/content/$APPID/$id")" ] || echo "$id" >> "$missing"
    done < "$NEEDFILE"
    [ -s "$missing" ] || return 0

    n=$((n + 1))
    echo "Retrying $(wc -l < "$missing" | tr -d ' ') download(s), attempt $n/$RETRIES, after a pause..." >&2
    sleep 10
    run_batch "${STEAM_USER:-anonymous}" "$missing"
  done
}

# Stage 3 (serial): copy each SteamCMD download into its ID/backup/ folder.
# IDs successfully backed up from SteamCMD are recorded in $DLFILE.
backup_downloaded() {
  [ -s "$NEEDFILE" ] || return 0
  while read -r id; do
    src=$(first_gma "$STEAMCMD_DIR/steamapps/workshop/content/$APPID/$id")
    if [ -z "$src" ]; then
      echo "SteamCMD did not download a .gma for $id. Check that the logged-in account owns the game (appid $APPID) and can access the item."
      continue
    fi
    mkdir -p "$(backup_dir "$id")" || continue
    if cp -p -- "$src" "$(backup_dir "$id")/"; then
      echo "$id" >> "$DLFILE"
      echo "Backed up SteamCMD download for $id"
    else
      echo "Backup copy failed for $id"
    fi
  done < "$NEEDFILE"
}

# Stage 4 (parallel worker): preview image and archive, from the backup.
process_id() {
  id=$1
  outdir=$(item_dir "$id")
  bdir=$(backup_dir "$id")
  status=0

  mkdir -p "$outdir" || return 1

  # Preview image
  if [ "$AVIF" -eq 1 ]; then target="$id.avif"; else target="$id.jpg"; fi
  if [ -f "$outdir/$target" ]; then
    echo "Image already present for $id"
  else
    url=$(image_url "$id")
    if [ -z "$url" ]; then
      echo "No image found for $id"
      status=1
    else
      echo "Downloading image for $id..."
      fetch_image "$id" "$url" "$outdir" || status=1
    fi
  fi

  # GMA archive: compress from the backup, verify, then drop the uncompressed copy
  gma=$(first_gma "$bdir")
  if [ -z "$(find_archive "$id")" ] && [ -n "$gma" ]; then
    date=$(retry item_date "$id")
    if [ -z "$date" ]; then
      echo "Could not get the Steam update date for $id; not archived"
      status=1
    else
      archive_gma "$id" "$gma" "$outdir" "$date" || status=1
    fi
  fi

  arc=$(find_archive "$id")
  if [ -z "$arc" ]; then
    echo "No .gma available for $id"
    status=1
  elif ! xz -t -- "$arc" 2>/dev/null; then
    echo "Archive failed verification for $id; keeping the uncompressed backup"
    status=1
  else
    raw=$(first_gma "$bdir")
    if [ -n "$raw" ]; then
      rm -f -- "$raw" && echo "Verified archive; removed uncompressed copy for $id"
    fi
    rmdir "$bdir" 2>/dev/null || true
    rmdir "$OUTDIR/.backup" 2>/dev/null || true
  fi

  if [ "$status" -eq 0 ]; then
    echo "Done: $id"
  else
    echo "Finished with errors: $id"
  fi
  return "$status"
}

# Stage 5 (serial): delete SteamCMD downloads once their archive is verified.
# Only deletes under $STEAMCMD_DIR, never the Steam client cache, and never a backup
# or archive. Copies whose archive is missing or fails the check are kept.
# Use -k to keep the downloads.
delete_downloaded() {
  [ "$KEEP_DOWNLOADS" -eq 1 ] && return 0

  while read -r id; do
    copy="$STEAMCMD_DIR/steamapps/workshop/content/$APPID/$id"
    [ -d "$copy" ] || continue

    arc=$(find_archive "$id")
    if [ -z "$arc" ] || ! xz -t -- "$arc" 2>/dev/null; then
      echo "Keeping $copy (verified archive missing)"
      continue
    fi

    case $copy in
      "$STEAMCMD_DIR"/*) rm -rf -- "$copy" && echo "Deleted SteamCMD download for $id" ;;
      *) echo "Refusing to delete outside $STEAMCMD_DIR: $copy" ;;
    esac
  done < "$IDLIST"
}

# ---------------------------------------------------------------------------
# Entry points
# ---------------------------------------------------------------------------

# Worker mode: invoked by xargs once per ID. Settings come in via exported variables.
if [ "${1:-}" = "--process" ]; then
  shift
  process_id "$1"
  exit $?
fi

# Defaults. Set after the worker dispatch above so workers keep the parent
# settings they were started with.
JOBS=4
RETRIES=3
QUALITY=52
SPEED=6
AVIF=0
OUTDIR=.
KEEP_DOWNLOADS=0
FLAT=0
APPID=4000

# Steam client cache: checked first for an existing .gma. Empty means
# "the Steam cache for APPID", filled in after option parsing.
STEAM_WORKSHOP=
# SteamCMD install/download dir. Workshop items it downloads land under here.
STEAMCMD=steamcmd
STEAMCMD_DIR="$HOME/.local/share/wsdl/steamcmd"
STEAM_USER=""

case ${1:-} in
  --help) usage; exit 0 ;;
esac

while getopts ":hkfao:g:u:c:d:w:j:r:q:s:" opt; do
  case $opt in
    h) usage; exit 0 ;;
    a) AVIF=1 ;;
    k) KEEP_DOWNLOADS=1 ;;
    f) FLAT=1 ;;
    o) OUTDIR=$OPTARG ;;
    g) APPID=$OPTARG ;;
    u) STEAM_USER=$OPTARG ;;
    c) STEAMCMD=$OPTARG ;;
    d) STEAMCMD_DIR=$OPTARG ;;
    w) STEAM_WORKSHOP=$OPTARG ;;
    j) JOBS=$OPTARG ;;
    r) RETRIES=$OPTARG ;;
    q) QUALITY=$OPTARG ;;
    s) SPEED=$OPTARG ;;
    :) echo "$(basename "$0"): option -$OPTARG requires an argument" >&2; usage >&2; exit 2 ;;
    *) echo "$(basename "$0"): unknown option -$OPTARG" >&2; usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

case $APPID in
  ''|*[!0-9]*) echo "$(basename "$0"): -g must be a numeric app ID" >&2; exit 2 ;;
esac
[ -n "$STEAM_WORKSHOP" ] || STEAM_WORKSHOP="$HOME/.local/share/Steam/steamapps/workshop/content/$APPID"

for n in "$JOBS" "$RETRIES"; do
  case $n in
    ''|*[!0-9]*|0) echo "$(basename "$0"): -j and -r must be positive integers" >&2; exit 2 ;;
  esac
done

if [ $# -eq 0 ] && [ -t 0 ]; then
  usage >&2
  exit 1
fi

DEPS="curl grep xargs file xz"
[ "$AVIF" -eq 1 ] && DEPS="$DEPS avifenc"
for cmd in $DEPS; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "$(basename "$0"): missing dependency: $cmd" >&2
    exit 1
  fi
done

# Output directory
mkdir -p "$OUTDIR" || { echo "$(basename "$0"): cannot create output directory: $OUTDIR" >&2; exit 1; }

# Working files
WORK=$(mktemp -d) || exit 1
trap 'rm -rf "$WORK"' EXIT
IDLIST="$WORK/ids"
NEEDFILE="$WORK/need"
DLFILE="$WORK/downloaded"
: > "$NEEDFILE"
: > "$DLFILE"

# Collect and validate IDs
{
  if [ $# -gt 0 ]; then
    printf '%s\n' "$@"
  else
    cat
  fi
} | tr -s ' \t\r' '\n' | awk 'NF' \
  | while read -r token; do
      id=$(normalize_id "$token")
      case $id in
        *[!0-9]*|'') echo "Skipping invalid ID or URL: $token" >&2 ;;
        *) echo "$id" ;;
      esac
    done \
  | awk '!seen[$0]++' > "$IDLIST"

if [ ! -s "$IDLIST" ]; then
  echo "$(basename "$0"): no valid IDs given" >&2
  exit 1
fi

# Path xargs uses to re-invoke this script in worker mode
SELF=$0
[ -f "$SELF" ] || SELF=$(command -v "$0")

export RETRIES QUALITY SPEED AVIF FLAT OUTDIR STEAM_WORKSHOP STEAMCMD_DIR APPID

# Stage 1: local cache -> backup; collect IDs that need SteamCMD
while read -r id; do
  prepare_id "$id"
  case $? in
    0) ;;
    2) echo "$id" >> "$NEEDFILE" ;;
    *) echo "Preparation failed for $id" ;;
  esac
done < "$IDLIST"

# Stage 2 + 3: SteamCMD download for the rest, then back up downloads
download_needed || echo "SteamCMD step failed; items not downloaded will be skipped." >&2
backup_downloaded

# Stage 4: image and archive, in parallel
xargs -r -n 1 -P "$JOBS" sh "$SELF" --process < "$IDLIST"
rc=$?

# Stage 5: optional cleanup of SteamCMD downloads
delete_downloaded

exit "$rc"
